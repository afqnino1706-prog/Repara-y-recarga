{
  "name": "repara-y-recarga-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST de Repara y Recarga — Sprint 1",
  "scripts": {
    "dev": "node --watch-path=./src src/index.js",
    "start": "node src/index.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma db push --force-reset && node prisma/seed.js",
    "db:studio": "prisma studio",
    "prod:preparar": "node scripts/usar-postgres.js && prisma generate && prisma db push --accept-data-loss && node prisma/seed.js --si-vacio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}